<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            style="-fx-background-color: #f5f7fa;"
            fx:controller="com.teach.javafx.controller.base.OutboundApplyController">

    <top>
        <VBox spacing="12" style="-fx-padding: 20 24 12 24; -fx-background-color: #f5f7fa;">

            <!-- 标题卡片 - 与出库审批管理样式完全一致 -->
            <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2); -fx-padding: 16 24 16 24;" spacing="12">
                <VBox spacing="2">
                    <Label text="出库申请管理" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1d3f66;" />
                    <Label text="提交与查看所有出库申请单据" style="-fx-font-size: 12px; -fx-text-fill: #86909c;" />
                </VBox>
            </HBox>

            <!-- 操作按钮区域 - 与出库审批按钮栏样式一致 -->
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2); -fx-padding: 12 24 12 24;">
                <Button text="+ 添加商品" onAction="#addGoods"
                        style="-fx-background-color: linear-gradient(to right, #00b42a, #23c343); -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 9 24 9 24; -fx-background-radius: 6; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,180,42,0.3), 6, 0, 0, 2);" />
                <Button text="删除选中" onAction="#deleteGoods"
                        style="-fx-background-color: white; -fx-text-fill: #f53f3f; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 9 22 9 22; -fx-background-radius: 6; -fx-border-color: #f53f3f; -fx-border-width: 1; -fx-border-radius: 6; -fx-cursor: hand;" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="备注：" style="-fx-font-size: 13px; -fx-text-fill: #4e5969; -fx-font-weight: bold;" />
                <TextField fx:id="remarkField" prefWidth="400" promptText="请输入本次出库的备注说明（选填）"
                           style="-fx-background-color: white; -fx-border-color: #e5e6eb; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 7 12 7 12; -fx-font-size: 13px;" />
                <Button text="提交申请" onAction="#submitApply"
                        style="-fx-background-color: #1677ff; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 24 8 24; -fx-background-radius: 6; -fx-cursor: hand;" />
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox style="-fx-padding: 0 24 20 24; -fx-background-color: #f5f7fa;">
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 4 0 10 0;">
                <Label text="商品明细" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1d3f66;" />
            </HBox>
            <TableView fx:id="detailTableView" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #f0f0f0; -fx-border-width: 1; -fx-border-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2); -fx-padding: 2;">
                <columns>
                    <TableColumn fx:id="materialCol" text="商品名称" prefWidth="220" />
                    <TableColumn fx:id="goodsSpecCol" text="规格型号" prefWidth="130" editable="true" />
                    <TableColumn fx:id="unitCol" text="单位" prefWidth="80" editable="true" />
                    <TableColumn fx:id="outNumCol" text="出库数量" prefWidth="100" editable="true" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>