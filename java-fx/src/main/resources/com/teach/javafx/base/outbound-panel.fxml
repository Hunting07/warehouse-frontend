<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            style="-fx-background-color: #f5f7fa;"
            fx:controller="com.teach.javafx.controller.base.OutOrderListController">

    <top>
        <VBox spacing="12" style="-fx-padding: 20 24 12 24; -fx-background-color: #f5f7fa;">

            <!-- 标题卡片 - 与出库审批管理样式完全一致 -->
            <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2); -fx-padding: 16 24 16 24;" spacing="12">
                <VBox spacing="2">
                    <Label fx:id="titleLabel" text="出库申请管理" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1d3f66;" />
                    <Label fx:id="subtitleLabel" text="提交与查看所有出库申请单据" style="-fx-font-size: 12px; -fx-text-fill: #86909c;" />
                </VBox>
            </HBox>

            <!-- 筛选条件和操作按钮合并卡片 -->
            <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2); -fx-padding: 16 24 16 24;">

                <!-- 筛选条件区域 -->
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="出库单号：" style="-fx-font-size: 13px; -fx-text-fill: #4e5969; -fx-font-weight: bold;" />
                    <TextField fx:id="searchOrderNoField" prefWidth="180" promptText="请输入单号模糊检索"
                               style="-fx-background-color: white; -fx-border-color: #e5e6eb; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 7 12 7 12; -fx-font-size: 13px;" />

                    <Label text="申请人：" style="-fx-font-size: 13px; -fx-text-fill: #4e5969; -fx-font-weight: bold;" />
                    <TextField fx:id="applicantNameField" prefWidth="140" promptText="填写申请人账号/姓名"
                               style="-fx-background-color: white; -fx-border-color: #e5e6eb; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 7 12 7 12; -fx-font-size: 13px;" />

                    <Label text="类型：" style="-fx-font-size: 13px; -fx-text-fill: #4e5969; -fx-font-weight: bold;" />
                    <ComboBox fx:id="typeComboBox" prefWidth="120" promptText="全部类型"
                              style="-fx-background-color: white; -fx-border-color: #e5e6eb; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6;" />

                    <Label text="状态：" style="-fx-font-size: 13px; -fx-text-fill: #4e5969; -fx-font-weight: bold;" />
                    <ComboBox fx:id="statusComboBox" prefWidth="120" promptText="全部状态"
                              style="-fx-background-color: white; -fx-border-color: #e5e6eb; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6;" />

                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="查询" onAction="#onSearchButtonClick"
                            style="-fx-background-color: #1677ff; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 24 8 24; -fx-background-radius: 6; -fx-cursor: hand;" />
                    <Button text="重置" onAction="#onResetButtonClick"
                            style="-fx-background-color: #f2f3f5; -fx-text-fill: #4e5969; -fx-font-size: 13px; -fx-font-weight: normal; -fx-padding: 8 24 8 24; -fx-background-radius: 6; -fx-border-color: #e5e6eb; -fx-border-width: 1; -fx-border-radius: 6; -fx-cursor: hand;" />
                </HBox>

                <!-- 操作按钮区域 -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="addButton" text="+ 新增出库单" onAction="#onAddButtonClick"
                            style="-fx-background-color: linear-gradient(to right, #52c41a, #73d13d); -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 9 24 9 24; -fx-background-radius: 6; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(82,196,26,0.2), 6, 0, 0, 2);" />
                    <Button fx:id="editButton" text="编辑" onAction="#onEditButtonClick"
                            style="-fx-background-color: #4096ff; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 9 22 9 22; -fx-background-radius: 6; -fx-cursor: hand;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="approveButton" text="删除" onAction="#onDeleteButtonClick"
                            style="-fx-background-color: white; -fx-text-fill: #f53f3f; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 9 22 9 22; -fx-background-radius: 6; -fx-border-color: #f53f3f; -fx-border-width: 1; -fx-border-radius: 6; -fx-cursor: hand;" />
                </HBox>
            </VBox>
        </VBox>
    </top>

    <!-- 表格区域 -->
    <center>
        <TableView fx:id="outOrderTable" BorderPane.alignment="CENTER"
                   style="-fx-background-color: white; -fx-background-radius: 0 0 8 8; -fx-border-color: #f0f0f0; -fx-border-width: 0 1 1 1; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2); -fx-padding: 2;"
                   VBox.vgrow="ALWAYS">
            <placeholder>
                <Label text="暂无数据" style="-fx-font-size: 14px; -fx-text-fill: #86909c;" />
            </placeholder>
            <columns>
                <TableColumn fx:id="indexColumn" text="序号" prefWidth="60" />
                <TableColumn fx:id="orderNoColumn" text="出库单号" prefWidth="140" />
                <TableColumn fx:id="outTypeColumn" text="出库类型" prefWidth="90" />
                <TableColumn fx:id="applicantNameColumn" text="申请人" prefWidth="80" />
                <TableColumn fx:id="materialNamesColumn" text="物资" prefWidth="150" />
                <TableColumn fx:id="totalAmountColumn" text="总金额" prefWidth="100" />
                <TableColumn fx:id="applyTimeColumn" text="申请时间" prefWidth="120" />
                <TableColumn fx:id="auditTimeColumn" text="审批时间" prefWidth="120" />
                <TableColumn fx:id="statusColumn" text="状态" prefWidth="80" />
                <TableColumn fx:id="auditUserNameColumn" text="审批人" prefWidth="80" />
                <TableColumn fx:id="actionColumn" text="操作" prefWidth="100" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </center>
</BorderPane>
