<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.teach.javafx.controller.base.StockInController">

    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="入库单号："/>
                <TextField fx:id="searchCodeField" prefWidth="150"/>

                <Label text="入库类型："/>
                <ComboBox fx:id="typeComboBox" prefWidth="120"/>

                <Label text="状态："/>
                <ComboBox fx:id="statusComboBox" prefWidth="100"/>

                <Button text="查询" onAction="#onSearchButtonClick"/>
                <Button text="重置" onAction="#onResetButtonClick"/>
            </HBox>

            <HBox spacing="10">
                <Button text="新增入库单" onAction="#onAddButtonClick"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                <Button fx:id="editButton" text="编辑" onAction="#onEditButtonClick"/>
                <Button fx:id="approveButton" text="审批" onAction="#onApproveButtonClick"
                        style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="stockInTable" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="serialNumberColumn" text="编号" prefWidth="60"/>
                <TableColumn fx:id="inCodeColumn" text="入库单号" prefWidth="150"/>
                <TableColumn fx:id="typeColumn" text="入库类型" prefWidth="100"/>
                <TableColumn fx:id="materialNameColumn" text="物资" prefWidth="150"/>
                <TableColumn fx:id="priceColumn" text="单价" prefWidth="100"/>
                <TableColumn fx:id="quantityColumn" text="数量" prefWidth="80"/>
                <TableColumn fx:id="totalAmountColumn" text="总金额" prefWidth="100"/>
                <TableColumn fx:id="statusColumn" text="状态" prefWidth="80"/>
                <TableColumn fx:id="applyUserColumn" text="申请人" prefWidth="100"/>
                <TableColumn fx:id="createTimeColumn" text="申请时间" prefWidth="150"/>
                <TableColumn fx:id="approveTimeColumn" text="审批时间" prefWidth="150"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>
</BorderPane>

