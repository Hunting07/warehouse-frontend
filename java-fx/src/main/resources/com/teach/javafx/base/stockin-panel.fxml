<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.teach.javafx.controller.base.StockInController"
      spacing="10" style="-fx-background-color: #f5f7fa;" VBox.vgrow="ALWAYS">

    <padding>
        <Insets top="12" right="12" bottom="12" left="12" />
    </padding>

    <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 12 16; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
        <Label fx:id="titleLabel" text="入库管理" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1d3f66;">
            <font>
                <Font name="Microsoft YaHei UI" size="20" />
            </font>
        </Label>
        <Label fx:id="subtitleLabel" text="管理入库单据" style="-fx-font-size: 12px; -fx-text-fill: #8c8c8c;" />
    </VBox>

    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 12 16; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
        <Label text="入库单号：" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #546e7a;" />
        <TextField fx:id="searchCodeField" promptText="请输入单号模糊检索" prefWidth="160"
                   style="-fx-font-size: 12px; -fx-padding: 6 10; -fx-background-radius: 4; -fx-border-color: #d9d9d9; -fx-border-radius: 4;" />

        <Label text="入库类型：" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #546e7a;" />
        <ComboBox fx:id="typeComboBox" prefWidth="120" style="-fx-font-size: 12px;" />

        <Label text="状态：" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #546e7a;" />
        <ComboBox fx:id="statusComboBox" prefWidth="110" style="-fx-font-size: 12px;" />

        <Region HBox.hgrow="ALWAYS" />

        <Button text="查询" onAction="#onSearchButtonClick"
                style="-fx-background-color: #4096ff; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 24; -fx-background-radius: 4; -fx-cursor: hand;" />
        <Button text="重置" onAction="#onResetButtonClick"
                style="-fx-background-color: #f5f5f5; -fx-text-fill: #546e7a; -fx-font-size: 13px; -fx-padding: 8 24; -fx-background-radius: 4; -fx-border-color: #d9d9d9; -fx-border-radius: 4; -fx-cursor: hand;" />
    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 12 16; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
        <Button text="+ 新增入库单" onAction="#onAddButtonClick"
                style="-fx-background-color: #52c41a; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 4; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(82, 196, 26, 0.2), 6, 0, 0, 2);" />
        <Button fx:id="editButton" text="编辑" onAction="#onEditButtonClick"
                style="-fx-background-color: #4096ff; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 4; -fx-cursor: hand;" />
        <Button fx:id="approveButton" text="审批" onAction="#onApproveButtonClick"
                style="-fx-background-color: #faad14; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 4; -fx-cursor: hand;" />

        <Region HBox.hgrow="ALWAYS" />

        <Button fx:id="deleteButton" text="删除" onAction="#onDeleteButtonClick"
                style="-fx-background-color: white; -fx-text-fill: #ff7875; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 4; -fx-border-color: #ff7875; -fx-border-radius: 4; -fx-border-width: 1; -fx-cursor: hand;" />
    </HBox>

    <TableView fx:id="stockInTable" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2); -fx-padding: 2;">
    <columns>
        <TableColumn fx:id="serialNumberColumn" text="编号" prefWidth="60" />
        <TableColumn fx:id="inCodeColumn" text="入库单号" prefWidth="150" />
        <TableColumn fx:id="typeColumn" text="入库类型" prefWidth="100" />
        <TableColumn fx:id="materialNameColumn" text="物资" prefWidth="150" />
        <TableColumn fx:id="totalAmountColumn" text="总金额" prefWidth="100" />
        <TableColumn fx:id="statusColumn" text="状态" prefWidth="80" />
        <TableColumn fx:id="applyUserColumn" text="申请人" prefWidth="100" />
        <TableColumn fx:id="createTimeColumn" text="申请时间" prefWidth="150" />
        <TableColumn fx:id="approveTimeColumn" text="审批时间" prefWidth="150" />
        <TableColumn fx:id="actionColumn" text="操作" prefWidth="120" />
    </columns>
    <columnResizePolicy>
        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
    </columnResizePolicy>
</TableView>

</VBox>

