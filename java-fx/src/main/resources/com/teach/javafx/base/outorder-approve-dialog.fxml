<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      style="-fx-background-color: #f5f7fa;"
      spacing="16"
      fx:controller="com.teach.javafx.controller.base.OutOrderApproveDialog"
      prefWidth="700" prefHeight="750">

    <!-- 标题区域 -->
    <VBox spacing="8" style="-fx-padding: 24 24 0 24;">
        <Label text="出库单审批" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1d3f66;" />
        <Separator style="-fx-background-color: #e5e6eb;" />
    </VBox>

    <!-- 基础信息卡片 -->
    <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2); -fx-padding: 20 24 20 24;">
        <HBox spacing="24">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="出库单号" style="-fx-font-size: 12px; -fx-text-fill: #86909c;" />
                <Label fx:id="orderNoLabel" style="-fx-font-size: 14px; -fx-text-fill: #1d3f66; -fx-font-weight: bold;" />
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="申请人" style="-fx-font-size: 12px; -fx-text-fill: #86909c;" />
                <Label fx:id="applicantLabel" style="-fx-font-size: 14px; -fx-text-fill: #1d3f66;" />
            </VBox>
        </HBox>
        <HBox spacing="24">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="出库类型" style="-fx-font-size: 12px; -fx-text-fill: #86909c;" />
                <Label fx:id="outTypeLabel" style="-fx-font-size: 14px; -fx-text-fill: #1d3f66;" />
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="申请时间" style="-fx-font-size: 12px; -fx-text-fill: #86909c;" />
                <Label fx:id="applyTimeLabel" style="-fx-font-size: 14px; -fx-text-fill: #1d3f66;" />
            </VBox>
        </HBox>
        <HBox spacing="24">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="总金额" style="-fx-font-size: 12px; -fx-text-fill: #86909c;" />
                <Label fx:id="totalAmountLabel" style="-fx-font-size: 14px; -fx-text-fill: #f53f3f; -fx-font-weight: bold;" />
            </VBox>
        </HBox>
    </VBox>

    <!-- 出库明细卡片 -->
    <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2); -fx-padding: 20 24 20 24;">
        <Label text="出库明细" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1d3f66;" />

        <TableView fx:id="detailTableView" VBox.vgrow="ALWAYS" prefHeight="200"
                   style="-fx-background-color: white; -fx-border-color: #f0f0f0; -fx-border-width: 1; -fx-border-radius: 6; -fx-padding: 2;">
            <columns>
                <TableColumn fx:id="materialCodeColumn" text="物资编号" prefWidth="120" />
                <TableColumn fx:id="materialColumn" text="物资名称" prefWidth="160" />
                <TableColumn fx:id="unitPriceColumn" text="单价" prefWidth="100" />
                <TableColumn fx:id="quantityColumn" text="出库数量" prefWidth="100" />
                <TableColumn fx:id="amountColumn" text="单品金额" prefWidth="100" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <!-- 合计行 -->
        <HBox spacing="24" alignment="CENTER_LEFT" style="-fx-padding: 12 0 0 0; -fx-border-color: #e5e6eb; -fx-border-width: 1 0 0 0;">
            <Label text="总数量:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1d3f66;" />
            <Label fx:id="totalQuantityLabel" text="0" style="-fx-font-size: 14px; -fx-text-fill: #389e0d; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" />
            <Label text="合计总金额:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1d3f66;" />
            <Label fx:id="totalAmountSummaryLabel" text="¥0.00" style="-fx-font-size: 14px; -fx-text-fill: #f53f3f; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" />
        </HBox>
    </VBox>

    <!-- 审批意见卡片 -->
    <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2); -fx-padding: 20 24 20 24;">
        <Label text="驳回理由（仅驳回时填写）" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1d3f66;" />
        <TextArea fx:id="rejectReasonArea" prefRowCount="3"
                  promptText="请输入驳回理由（仅驳回时需要）"
                  style="-fx-background-color: white; -fx-border-color: #e5e6eb; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 12 8 12; -fx-font-size: 13px;" />
    </VBox>

    <!-- 操作按钮栏 -->
    <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 0 24 24 24;">
        <Region HBox.hgrow="ALWAYS" />
        <Button text="驳回" onAction="#onRejectButtonClick"
                style="-fx-background-color: white; -fx-text-fill: #f53f3f; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 32 10 32; -fx-background-radius: 6; -fx-border-color: #f53f3f; -fx-border-width: 1; -fx-border-radius: 6; -fx-cursor: hand;" />
        <Button text="批准" onAction="#onApproveButtonClick"
                style="-fx-background-color: linear-gradient(to right, #389e0d, #52c41a); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 32 10 32; -fx-background-radius: 6; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(56,158,13,0.25), 6, 0, 0, 2);" />
        <Button text="取消" onAction="#onCancelButtonClick"
                style="-fx-background-color: #f2f3f5; -fx-text-fill: #4e5969; -fx-font-size: 14px; -fx-padding: 10 32 10 32; -fx-background-radius: 6; -fx-border-color: #e5e6eb; -fx-border-width: 1; -fx-border-radius: 6; -fx-cursor: hand;" />
    </HBox>
</VBox>

