<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.teach.javafx.controller.base.AdminViewController"
      spacing="15"
      style="-fx-background-color: #f5f7fa;">

    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="管理员查看" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="刷新" onAction="#loadUserList"
                style="-fx-background-color: #4a90d9; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 6; -fx-cursor: hand;"/>
    </HBox>

    <Separator style="-fx-background-color: #e0e6ed;"/>

    <Label text="管理员列表" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <TableView fx:id="adminTable" VBox.vgrow="ALWAYS" prefHeight="500"
               style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e0e6ed; -fx-border-radius: 8;">
        <columns>
            <TableColumn fx:id="colAdminId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colAdminAccount" text="账号" prefWidth="120"/>
            <TableColumn fx:id="colAdminName" text="姓名" prefWidth="100"/>
            <TableColumn fx:id="colAdminPhone" text="电话" prefWidth="130"/>
            <TableColumn fx:id="colAdminRole" text="角色" prefWidth="80"/>
            <TableColumn fx:id="colAdminStatus" text="状态" prefWidth="100"/>
            <TableColumn fx:id="colAdminTime" text="创建时间" prefWidth="160"/>
        </columns>
    </TableView>

</VBox>
