<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.teach.javafx.controller.base.EmployeeViewController"
      spacing="15"
      style="-fx-background-color: #f5f7fa;">

    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="员工管理" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="刷新" onAction="#loadEmployeeList"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 5; -fx-cursor: hand;" prefWidth="100"/>
    </HBox>

    <TableView fx:id="employeeTable" VBox.vgrow="ALWAYS"
               style="-fx-background-color: white; -fx-border-color: #e0e6ed; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5;">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="80"/>
            <TableColumn fx:id="usernameColumn" text="用户名" prefWidth="120"/>
            <TableColumn fx:id="realNameColumn" text="姓名" prefWidth="120"/>
            <TableColumn fx:id="phoneColumn" text="手机号" prefWidth="150"/>
            <TableColumn fx:id="roleColumn" text="角色" prefWidth="120"/>
            <TableColumn fx:id="statusColumn" text="状态" prefWidth="100"/>
            <TableColumn fx:id="createTimeColumn" text="创建时间" prefWidth="180"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</VBox>
