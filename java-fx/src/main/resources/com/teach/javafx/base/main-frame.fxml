<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.TreeView?>
<!-- 前端应用主框架FXML配置文件 对应页面交互控制类 com.teach.javafx.controller.base.MainFrameController -->
<BorderPane fx:id="mainBorderPane"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.teach.javafx.controller.base.MainFrameController"
            style="-fx-background-image: url('main-bg.jpg'); -fx-background-size: cover; -fx-background-position: center;">


  <top>
    <MenuBar fx:id="menuBar" styleClass="menu-bar" />
  </top>
  <left>
    <TreeView fx:id="menuTree" prefWidth="200" styleClass="tree-view"/>
  </left>
  <center>
    <TabPane fx:id="contentTabPane" styleClass="tab-pane" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
    </TabPane>
  </center>
  <bottom>
    <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="5.0">
      <children>
        <Label styleClass="status-label" text="准备就绪" HBox.hgrow="ALWAYS" fx:id="systemPrompt" />
        <Pane prefHeight="-1.0" prefWidth="-1.0" HBox.hgrow="ALWAYS" />
        <Label styleClass="status-label" text="" HBox.hgrow="NEVER" />
      </children>
      <padding>
        <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
      </padding>
    </HBox>
  </bottom>
</BorderPane>
