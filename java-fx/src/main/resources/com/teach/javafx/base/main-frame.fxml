<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Separator?>
<!-- 前端应用主框架FXML配置文件 对应页面交互控制类 com.teach.javafx.controller.base.MainFrameController -->
<BorderPane fx:id="mainBorderPane"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.teach.javafx.controller.base.MainFrameController"
            style="-fx-background-color: #f8f9fa;">


  <top>
    <VBox>
      <HBox alignment="CENTER_LEFT" style="-fx-padding: 18 30 14 30; -fx-background-color: #4a90d9;">
        <Label text="仓储管理系统" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;">
          <font>
            <Font name="Microsoft YaHei UI Bold" size="28" />
          </font>
        </Label>
        <Label text="Warehouse Management System" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white; -fx-padding: 0 0 0 15;">
          <font>
            <Font name="Microsoft YaHei UI" size="16" />
          </font>
        </Label>
        <Pane HBox.hgrow="ALWAYS" />
        <HBox fx:id="welcomeBox" alignment="CENTER_RIGHT" spacing="15" style="-fx-padding: 0 10 0 0;">
          <Label fx:id="welcomeLabel" text="" style="-fx-font-size: 15px; -fx-text-fill: white; -fx-font-weight: bold;">
            <font>
              <Font name="Microsoft YaHei UI" size="15" />
            </font>
          </Label>
          <Label fx:id="timeLabel" text="" style="-fx-font-size: 14px; -fx-text-fill: white;">
            <font>
              <Font name="Microsoft YaHei UI" size="14" />
            </font>
          </Label>
          <Button fx:id="logoutButton" text="退出登录" onAction="#handleLogout"
                  style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-padding: 6 18; -fx-cursor: hand; -fx-background-radius: 6; -fx-border-color: rgba(255,255,255,0.5); -fx-border-width: 1; -fx-border-radius: 6;" />
        </HBox>
      </HBox>
      <MenuBar fx:id="menuBar" styleClass="menu-bar" />
    </VBox>
  </top>
  <left>
    <TreeView fx:id="menuTree" prefWidth="200" styleClass="tree-view"/>
  </left>
  <center>
    <StackPane>
      <VBox fx:id="dashboardView" style="-fx-padding: 20 20 20 20; -fx-spacing: 20;">
        <!-- 欢迎提示区域 -->
        <VBox styleClass="dashboard-card" style="-fx-padding: 25; -fx-background-color: linear-gradient(to right, #e3f2fd, #f3e5f5);">
          <children>
            <HBox alignment="CENTER_LEFT" spacing="15">
              <children>
                <Label text="👋" style="-fx-font-size: 40px;" />
                <VBox spacing="5">
                  <children>
                    <Label fx:id="welcomeMessageLabel" text="" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                    <Label fx:id="subWelcomeLabel" text="" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" />
                  </children>
                </VBox>
              </children>
            </HBox>
          </children>
        </VBox>

        <!-- 统计卡片区域 -->
        <HBox spacing="20" style="-fx-padding: 0 0 10 0;" alignment="CENTER_LEFT">
          <children>
            <VBox styleClass="dashboard-card" HBox.hgrow="ALWAYS">
              <children>
                <Label text="📦" style="-fx-font-size: 36px; -fx-padding: 0 0 10 0;" />
                <Label text="物资总数" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d; -fx-padding: 0 0 5 0;" />
                <Label fx:id="totalMaterialsLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #4a90d9;" />
              </children>
            </VBox>
            <VBox styleClass="dashboard-card" HBox.hgrow="ALWAYS">
              <children>
                <Label text="📥" style="-fx-font-size: 36px; -fx-padding: 0 0 10 0;" />
                <Label text="今日入库" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d; -fx-padding: 0 0 5 0;" />
                <Label fx:id="todayInLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #4caf7d;" />
              </children>
            </VBox>
            <VBox styleClass="dashboard-card" HBox.hgrow="ALWAYS">
              <children>
                <Label text="📤" style="-fx-font-size: 36px; -fx-padding: 0 0 10 0;" />
                <Label text="今日出库" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d; -fx-padding: 0 0 5 0;" />
                <Label fx:id="todayOutLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #f0b84d;" />
              </children>
            </VBox>
            <VBox styleClass="dashboard-card" HBox.hgrow="ALWAYS">
              <children>
                <Label text="️" style="-fx-font-size: 36px; -fx-padding: 0 0 10 0;" />
                <Label text="库存预警" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d; -fx-padding: 0 0 5 0;" />
                <Label fx:id="warningCountLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #e87070;" />
              </children>
            </VBox>
            <VBox styleClass="dashboard-card" alignment="CENTER" prefWidth="150" HBox.hgrow="ALWAYS">
              <children>
                <Label text="🔄" style="-fx-font-size: 36px; -fx-padding: 0 0 10 0;" />
                <Button fx:id="refreshButton" text="刷新" onAction="#handleRefresh"
                        style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-background-color: #4a90d9; -fx-text-fill: white; -fx-padding: 8 15; -fx-cursor: hand;"
                        prefWidth="110" prefHeight="38" />
              </children>
            </VBox>
          </children>
        </HBox>

        <!-- 系统功能介绍区域 -->
        <HBox spacing="20">
          <children>
            <VBox styleClass="dashboard-card" HBox.hgrow="ALWAYS" style="-fx-padding: 20;">
              <children>
                <Label text="📋 系统功能" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 0 0 12 0;" />
                <VBox spacing="8">
                  <children>
                    <Label text="📦 物资分类 - 管理物资分类信息" style="-fx-font-size: 13px; -fx-text-fill: #34495e;" />
                    <Label text="📋 物资管理 - 管理仓库物资信息" style="-fx-font-size: 13px; -fx-text-fill: #34495e;" />
                    <Label fx:id="stockInFunctionLabel" text="" style="-fx-font-size: 13px; -fx-text-fill: #34495e;" />
                    <Label fx:id="stockOutFunctionLabel" text="" style="-fx-font-size: 13px; -fx-text-fill: #34495e;" />
                  </children>
                </VBox>
              </children>
            </VBox>
            <VBox styleClass="dashboard-card" HBox.hgrow="ALWAYS" style="-fx-padding: 20;">
              <children>
                <Label text="🔧 快捷提示" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 0 0 12 0;" />
                <VBox spacing="8">
                  <children>
                    <Label text="💡 点击左侧菜单切换功能页面" style="-fx-font-size: 13px; -fx-text-fill: #34495e;" />
                    <Label text="💡 顶部标签页支持多任务切换" style="-fx-font-size: 13px; -fx-text-fill: #34495e;" />
                    <Label text="💡 关注库存预警及时处理" style="-fx-font-size: 13px; -fx-text-fill: #34495e;" />
                    <Label text="💡 定期备份数据保障安全" style="-fx-font-size: 13px; -fx-text-fill: #34495e;" />
                  </children>
                </VBox>
              </children>
            </VBox>
          </children>
        </HBox>

        <!-- 温馨提示区域 -->
        <VBox styleClass="dashboard-card" style="-fx-padding: 20; -fx-background-color: linear-gradient(to right, #fff9c4, #fff3e0);">
          <children>
            <HBox alignment="CENTER_LEFT" spacing="10">
              <children>
                <Label text="💡" style="-fx-font-size: 24px;" />
                <Label text="温馨提示" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #e65100;" />
              </children>
            </HBox>
            <Label fx:id="tipLabel" text="" style="-fx-font-size: 13px; -fx-text-fill: #5d4037; -fx-padding: 10 0 0 0;" wrapText="true" />
          </children>
        </VBox>
      </VBox>
      <TabPane fx:id="contentTabPane" styleClass="tab-pane" tabClosingPolicy="UNAVAILABLE" visible="false" managed="false">
      </TabPane>
    </StackPane>
  </center>
  <bottom>
    <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="5.0">
      <children>
        <Label styleClass="status-label" text="准备就绪" HBox.hgrow="ALWAYS" fx:id="systemPrompt" />
        <Pane prefHeight="-1.0" prefWidth="-1.0" HBox.hgrow="ALWAYS" />
        <Button fx:id="switchRoleBtn" text="切换管理员/员工" onAction="#handleSwitchRole"
                style="-fx-font-size: 12px; -fx-background-color: #ff9800; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 4 12; -fx-cursor: hand;" />
        <Label styleClass="status-label" text="" HBox.hgrow="NEVER" />
      </children>
      <padding>
        <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
      </padding>
    </HBox>
  </bottom>
</BorderPane>
