<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.StackPane?>
<!-- 前端应用主框架FXML配置文件 对应页面交互控制类 com.teach.javafx.controller.base.MainFrameController -->
<BorderPane fx:id="mainBorderPane"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.teach.javafx.controller.base.MainFrameController"
            style="-fx-background-color: #f8f9fa;">


  <top>
    <VBox>
      <HBox alignment="CENTER_LEFT" style="-fx-padding: 18 30 14 30; -fx-background-color: #4a90d9;">
        <Label text="仓储管理系统" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;">
          <font>
            <Font name="Microsoft YaHei UI Bold" size="28" />
          </font>
        </Label>
        <Label text="Warehouse Management System" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white; -fx-padding: 0 0 0 15;">
          <font>
            <Font name="Microsoft YaHei UI" size="16" />
          </font>
        </Label>
        <Pane HBox.hgrow="ALWAYS" />
        <HBox fx:id="welcomeBox" alignment="CENTER_RIGHT" spacing="15" style="-fx-padding: 0 10 0 0;">
          <Label fx:id="welcomeLabel" text="" style="-fx-font-size: 15px; -fx-text-fill: white; -fx-font-weight: bold;">
            <font>
              <Font name="Microsoft YaHei UI" size="15" />
            </font>
          </Label>
          <Label fx:id="timeLabel" text="" style="-fx-font-size: 14px; -fx-text-fill: white;">
            <font>
              <Font name="Microsoft YaHei UI" size="14" />
            </font>
          </Label>
        </HBox>
      </HBox>
      <MenuBar fx:id="menuBar" styleClass="menu-bar" />
    </VBox>
  </top>
  <left>
    <TreeView fx:id="menuTree" prefWidth="200" styleClass="tree-view"/>
  </left>
  <center>
    <StackPane>
      <VBox fx:id="dashboardView" style="-fx-padding: 20 20 20 20; -fx-spacing: 20;">
        <HBox spacing="20" style="-fx-padding: 0 0 10 0;" alignment="CENTER_LEFT">
          <children>
            <VBox styleClass="dashboard-card" HBox.hgrow="ALWAYS">
              <children>
                <Label text="📦" style="-fx-font-size: 36px; -fx-padding: 0 0 10 0;" />
                <Label text="物资总数" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d; -fx-padding: 0 0 5 0;" />
                <Label fx:id="totalMaterialsLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #4a90d9;" />
              </children>
            </VBox>
            <VBox styleClass="dashboard-card" HBox.hgrow="ALWAYS">
              <children>
                <Label text="📥" style="-fx-font-size: 36px; -fx-padding: 0 0 10 0;" />
                <Label text="今日入库" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d; -fx-padding: 0 0 5 0;" />
                <Label fx:id="todayInLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #4caf7d;" />
              </children>
            </VBox>
            <VBox styleClass="dashboard-card" HBox.hgrow="ALWAYS">
              <children>
                <Label text="📤" style="-fx-font-size: 36px; -fx-padding: 0 0 10 0;" />
                <Label text="今日出库" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d; -fx-padding: 0 0 5 0;" />
                <Label fx:id="todayOutLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #f0b84d;" />
              </children>
            </VBox>
            <VBox styleClass="dashboard-card" HBox.hgrow="ALWAYS">
              <children>
                <Label text="⚠️" style="-fx-font-size: 36px; -fx-padding: 0 0 10 0;" />
                <Label text="库存预警" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d; -fx-padding: 0 0 5 0;" />
                <Label fx:id="warningCountLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #e87070;" />
              </children>
            </VBox>
            <VBox styleClass="dashboard-card" alignment="CENTER" prefWidth="150" HBox.hgrow="ALWAYS">
              <children>
                <Label text="🔄" style="-fx-font-size: 36px; -fx-padding: 0 0 10 0;" />
                <Button fx:id="refreshButton" text="刷新" onAction="#handleRefresh"
                        style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-background-color: #4a90d9; -fx-text-fill: white; -fx-padding: 8 15; -fx-cursor: hand;"
                        prefWidth="110" prefHeight="38" />
              </children>
            </VBox>
          </children>
        </HBox>
      </VBox>
      <TabPane fx:id="contentTabPane" styleClass="tab-pane" tabClosingPolicy="UNAVAILABLE" visible="false" managed="false">
      </TabPane>
    </StackPane>
  </center>
  <bottom>
    <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="5.0">
      <children>
        <Label styleClass="status-label" text="准备就绪" HBox.hgrow="ALWAYS" fx:id="systemPrompt" />
        <Pane prefHeight="-1.0" prefWidth="-1.0" HBox.hgrow="ALWAYS" />
        <Label styleClass="status-label" text="" HBox.hgrow="NEVER" />
      </children>
      <padding>
        <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
      </padding>
    </HBox>
  </bottom>
</BorderPane>
