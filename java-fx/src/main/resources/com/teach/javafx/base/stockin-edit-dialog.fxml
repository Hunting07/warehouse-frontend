<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.teach.javafx.controller.base.StockInEditDialog"
      spacing="15" prefWidth="800" prefHeight="580"
      style="-fx-background-color: linear-gradient(to bottom, #f5f7fa, #ffffff);">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <!-- 标题栏 -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="titleLabel" text="新增入库单"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <Separator style="-fx-background-color: #e0e6ed;"/>

    <!-- 入库类型选择区域 -->
    <HBox spacing="12" alignment="CENTER_LEFT"
          style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.05), 5, 0, 0, 1);">
        <Label text="入库类型："
               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-min-width: 80;"/>
        <ComboBox fx:id="typeComboBox" prefWidth="220"
                  style="-fx-font-size: 13px;"/>
    </HBox>

    <!-- 入库明细标题 -->
    <Label text="入库明细"
           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <!-- 明细表格 -->
    <TableView fx:id="itemTable" prefHeight="280" VBox.vgrow="ALWAYS"
               styleClass="stockin-edit-table">
        <columns>
            <TableColumn fx:id="materialColumn" text="物资" prefWidth="200"/>
            <TableColumn fx:id="quantityColumn" text="数量" prefWidth="100"/>
            <TableColumn fx:id="priceColumn" text="单价" prefWidth="100"/>
            <TableColumn fx:id="amountColumn" text="金额" prefWidth="100"/>
            <TableColumn fx:id="actionColumn" text="操作" prefWidth="80"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <!-- 添加物资和总金额区域 -->
    <HBox spacing="15" alignment="CENTER_LEFT"
          style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 12 15; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.05), 5, 0, 0, 1);">
        <Button text="+ 添加物资" onAction="#onAddItemButtonClick"
                style="-fx-background-color: #4caf7d; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 6; -fx-cursor: hand;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="totalAmountLabel" text="总金额：¥0.00"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #e87070;"/>
    </HBox>

    <!-- 操作按钮区域 -->
    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button text="取消" onAction="#onCancelButtonClick"
                style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 25; -fx-background-radius: 6; -fx-border-color: #e0e6ed; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-cursor: hand;"/>
        <Button text="提交" onAction="#onSubmitButtonClick"
                style="-fx-background-color: #4a90d9; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 30; -fx-background-radius: 6; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(74, 144, 217, 0.3), 8, 0, 0, 2);"/>
    </HBox>
</VBox>

