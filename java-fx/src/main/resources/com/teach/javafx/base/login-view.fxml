<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.teach.javafx.controller.base.LoginController"
      style="-fx-background-color: white;"
      spacing="0">

    <!-- 左侧图片区域 - 方正比例，完整显示 -->
    <VBox style="-fx-background-image: url('login-bg.jpg'); -fx-background-size: cover; -fx-background-position: center;"
          prefWidth="600" maxWidth="600" minWidth="600"/>

    <!-- 右侧登录表单区域 - 白色背景 -->
    <VBox alignment="CENTER" spacing="20.0"
          style="-fx-background-color: #ffffff;"
          prefWidth="400" maxWidth="400" minWidth="400">
        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>

        <VBox alignment="CENTER" spacing="20" maxWidth="320">
            <Label text="欢迎登录" styleClass="title"
                   style="-fx-font-size: 28px; -fx-text-fill: #4a90d9;"/>

            <Label text="仓储管理系统"
                   style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>

            <GridPane hgap="10" vgap="15">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" maxWidth="70" minWidth="70" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="200" prefWidth="220" />
                </columnConstraints>

                <Label text="用户名" GridPane.columnIndex="0" GridPane.rowIndex="0"
                       style="-fx-text-fill: #2c3e50; -fx-font-size: 14px;"/>
                <TextField fx:id="usernameField" GridPane.columnIndex="1" GridPane.rowIndex="0"
                           promptText="请输入用户名" styleClass="text-field"/>

                <Label text="密码" GridPane.columnIndex="0" GridPane.rowIndex="1"
                       style="-fx-text-fill: #2c3e50; -fx-font-size: 14px;"/>
                <HBox GridPane.columnIndex="1" GridPane.rowIndex="1" spacing="5">
                    <PasswordField fx:id="passwordField" HBox.hgrow="ALWAYS"
                                   promptText="请输入密码" styleClass="password-field"/>
                    <Button fx:id="passwordToggleBtn" text="👁" onAction="#togglePasswordVisibility"
                            styleClass="secondary" prefWidth="40"/>
                </HBox>
            </GridPane>

            <VBox spacing="10" alignment="CENTER">
                <Button onAction="#onAdminLoginButtonClick" text="管理员登录"
                        styleClass="button" prefWidth="280" prefHeight="45"/>

                <Button onAction="#onEmployeeLoginButtonClick" text="员工登录"
                        styleClass="button success" prefWidth="280" prefHeight="45"/>

                <Button onAction="#onRegisterButtonClick" text="用户注册"
                        styleClass="button secondary" prefWidth="280" prefHeight="45"/>
            </VBox>
        </VBox>
    </VBox>
</HBox>
