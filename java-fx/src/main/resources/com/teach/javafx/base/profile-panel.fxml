<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.teach.javafx.controller.base.ProfileController"
      spacing="20"
      style="-fx-background-color: #f5f7fa;"
      VBox.vgrow="ALWAYS">

    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <!-- 页面标题 -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="个人中心" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #4a90d9;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="退出登录" onAction="#handleLogout"
                style="-fx-background-color: linear-gradient(to right, #ff6b6b, #ee5a6f); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 20; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(238,90,111,0.3), 8, 0, 0, 2);"/>
    </HBox>

    <!-- 左右两栏布局 -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <!-- 左侧：个人信息 -->
        <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);" spacing="15">

            <Label text="个人信息" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <Separator/>

            <GridPane hgap="15" vgap="12">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="80" prefWidth="80"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="200"/>
                </columnConstraints>

                <Label text="工号：" GridPane.rowIndex="0" GridPane.columnIndex="0"
                       style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
                <Label fx:id="employeeIdLabel" text="" GridPane.rowIndex="0" GridPane.columnIndex="1"
                       style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-padding: 8 12; -fx-background-color: #f8f9fa; -fx-background-radius: 6;"/>

                <Label text="用户名：" GridPane.rowIndex="1" GridPane.columnIndex="0"
                       style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
                <Label fx:id="usernameLabel" text="" GridPane.rowIndex="1" GridPane.columnIndex="1"
                       style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-padding: 8 12; -fx-background-color: #f8f9fa; -fx-background-radius: 6;"/>

                <Label text="角色：" GridPane.rowIndex="2" GridPane.columnIndex="0"
                       style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
                <Label fx:id="roleLabel" text="" GridPane.rowIndex="2" GridPane.columnIndex="1"
                       style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-padding: 8 12; -fx-background-color: #f8f9fa; -fx-background-radius: 6;"/>

                <Label text="姓名：" GridPane.rowIndex="3" GridPane.columnIndex="0"
                       style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
                <TextField fx:id="nameField" promptText="请输入姓名" GridPane.rowIndex="3" GridPane.columnIndex="1"
                           style="-fx-font-size: 14px; -fx-background-color: white; -fx-border-color: #e0e6ed; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 12;"/>

                <Label text="电话：" GridPane.rowIndex="4" GridPane.columnIndex="0"
                       style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
                <TextField fx:id="phoneField" promptText="请输入电话" GridPane.rowIndex="4" GridPane.columnIndex="1"
                           style="-fx-font-size: 14px; -fx-background-color: white; -fx-border-color: #e0e6ed; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 12;"/>

                <Button text="保存信息" onAction="#handleUpdateProfile" GridPane.rowIndex="5" GridPane.columnIndex="1"
                        style="-fx-background-color: linear-gradient(to right, #4a90d9, #357abd); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 30; -fx-background-radius: 6; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(74,144,217,0.3), 8, 0, 0, 2);"/>
            </GridPane>
        </VBox>

        <!-- 右侧：修改密码 -->
        <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);" spacing="15">

            <Label text="修改密码" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <Separator/>

            <GridPane hgap="15" vgap="12">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="100" prefWidth="100"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="200"/>
                </columnConstraints>

                <Label text="旧密码：" GridPane.rowIndex="0" GridPane.columnIndex="0"
                       style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
                <HBox GridPane.rowIndex="0" GridPane.columnIndex="1" spacing="8" style="-fx-alignment: CENTER_LEFT;">
                    <PasswordField fx:id="oldPasswordField" promptText="请输入旧密码"
                                   style="-fx-font-size: 14px; -fx-background-color: white; -fx-border-color: #e0e6ed; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 12;" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="oldPasswordToggleBtn" text="️" onAction="#toggleOldPasswordVisibility"
                            style="-fx-background-color: #f5f7fa; -fx-font-size: 14px; -fx-cursor: hand; -fx-background-radius: 6; -fx-border-color: #e0e6ed; -fx-border-width: 1.5; -fx-border-radius: 6;" prefWidth="40" prefHeight="36"/>
                </HBox>

                <Label text="新密码：" GridPane.rowIndex="1" GridPane.columnIndex="0"
                       style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
                <HBox GridPane.rowIndex="1" GridPane.columnIndex="1" spacing="8" style="-fx-alignment: CENTER_LEFT;">
                    <PasswordField fx:id="newPasswordField" promptText="请输入新密码"
                                   style="-fx-font-size: 14px; -fx-background-color: white; -fx-border-color: #e0e6ed; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 12;" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="newPasswordToggleBtn" text="️" onAction="#toggleNewPasswordVisibility"
                            style="-fx-background-color: #f5f7fa; -fx-font-size: 14px; -fx-cursor: hand; -fx-background-radius: 6; -fx-border-color: #e0e6ed; -fx-border-width: 1.5; -fx-border-radius: 6;" prefWidth="40" prefHeight="36"/>
                </HBox>

                <Label text="确认新密码：" GridPane.rowIndex="2" GridPane.columnIndex="0"
                       style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
                <HBox GridPane.rowIndex="2" GridPane.columnIndex="1" spacing="8" style="-fx-alignment: CENTER_LEFT;">
                    <PasswordField fx:id="confirmPasswordField" promptText="请再次输入新密码"
                                   style="-fx-font-size: 14px; -fx-background-color: white; -fx-border-color: #e0e6ed; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 12;" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="confirmPasswordToggleBtn" text="️" onAction="#toggleConfirmPasswordVisibility"
                            style="-fx-background-color: #f5f7fa; -fx-font-size: 14px; -fx-cursor: hand; -fx-background-radius: 6; -fx-border-color: #e0e6ed; -fx-border-width: 1.5; -fx-border-radius: 6;" prefWidth="40" prefHeight="36"/>
                </HBox>

                <Button text="修改密码" onAction="#handleChangePassword" GridPane.rowIndex="3" GridPane.columnIndex="1"
                        style="-fx-background-color: linear-gradient(to right, #4a90d9, #357abd); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 30; -fx-background-radius: 6; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(74,144,217,0.3), 8, 0, 0, 2);"/>
            </GridPane>
        </VBox>

    </HBox>

</VBox>

