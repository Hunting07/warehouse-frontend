<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.teach.javafx.controller.base.StockWarningController"
            prefHeight="600.0" prefWidth="1200.0"
            style="-fx-background-color: #f5f7fa;">
    <top>
        <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20 25 15 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 4, 0, 0, 2);">
            <!-- 标题区域 -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="⚠️" style="-fx-font-size: 28px;"/>
                <Label text="库存预警" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
                    <font>
                        <Font name="Microsoft YaHei UI" size="22" />
                    </font>
                </Label>
                <Label text="需要及时处理库存不足的物资" style="-fx-font-size: 13px; -fx-text-fill: #95a5a6; -fx-padding: 0 0 0 10;" />
            </HBox>

            <!-- 统计卡片 -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <VBox style="-fx-background-color: linear-gradient(to bottom right, #fff5f5, #ffe6e6); -fx-padding: 18 30 18 30; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">
                    <Label text="库存不足" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;" />
                    <HBox alignment="BASELINE_LEFT" spacing="8">
                        <Label fx:id="warningCountLabel" text="0" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;" />
                        <Label text="项" style="-fx-font-size: 14px; -fx-text-fill: #95a5a6;" />
                    </HBox>
                </VBox>

                <VBox style="-fx-background-color: linear-gradient(to bottom right, #f8f9fa, #e9ecef); -fx-padding: 18 30 18 30; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">
                    <Label text="物资总计" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;" />
                    <HBox alignment="BASELINE_LEFT" spacing="8">
                        <Label fx:id="totalCountLabel" text="0" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #34495e;" />
                        <Label text="项" style="-fx-font-size: 14px; -fx-text-fill: #95a5a6;" />
                    </HBox>
                </VBox>
            </HBox>

            <!-- 搜索和操作区域 -->
            <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 5 0 0 0;">
                <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-background-color: #f8f9fa; -fx-padding: 8 15 8 15; -fx-background-radius: 8;">
                    <Label text="🔍" style="-fx-font-size: 16px;" />
                    <TextField fx:id="searchField" promptText="搜索物资名称或编码..." prefWidth="280" style="-fx-background-color: transparent; -fx-font-size: 13px;" />
                </HBox>
                <Button text="搜索" onAction="#searchWarning"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 20 8 20; -fx-background-radius: 8; -fx-cursor: hand;" />
                <Button text="重置" onAction="#resetSearch"
                        style="-fx-background-color: #ecf0f1; -fx-text-fill: #7f8c8d; -fx-font-size: 13px; -fx-padding: 8 20 8 20; -fx-background-radius: 8; -fx-cursor: hand;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="exportBtn" text="📥 导出" onAction="#exportWarnings"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 20 8 20; -fx-background-radius: 6; -fx-cursor: hand;" />
                <Button text="🔄 刷新" onAction="#loadWarnings"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 20 8 20; -fx-background-radius: 6; -fx-cursor: hand;" />
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="warningTable" prefHeight="500.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2); -fx-padding: 3;">
            <columns>
                <TableColumn fx:id="idCol" text="序号" prefWidth="70" />
                <TableColumn fx:id="nameCol" text="物资名称" prefWidth="180" />
                <TableColumn fx:id="codeCol" text="物资编码" prefWidth="150" />
                <TableColumn fx:id="categoryNameCol" text="所属分类" prefWidth="140" />
                <TableColumn fx:id="currentStockCol" text="当前库存" prefWidth="100" />
                <TableColumn fx:id="safetyStockCol" text="安全库存" prefWidth="100" />
                <TableColumn fx:id="shortageCol" text="短缺数量" prefWidth="100" />
                <TableColumn fx:id="updateTimeCol" text="更新时间" prefWidth="180" />
                <TableColumn fx:id="actionCol" text="操作" prefWidth="120" style="-fx-alignment: CENTER;" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </center>
</BorderPane>
